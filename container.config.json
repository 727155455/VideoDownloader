{
	// 本配置文件仅配合模板部署使用，为模板部署的服务生成「服务设置」的初始值。
	// 模板部署结束后，后续服务发布与本配置文件完全无关，修改「服务设置」请到控制台操作。
	// 复制模板代码自行开发请忽略本配置文件。
	
	"containerPort": 80,                          
	"minNum": 0,                                    
	"maxNum": 5,                                
	"cpu": 1,                               
	"mem": 2,                           
	"policyType": "cpu",                       
	"policyThreshold": 60,   
	"policyDetails": [
		{
			"PolicyType": "cpu",
			"PolicyThreshold": 60
		},
		{
			"PolicyType": "mem",
			"PolicyThreshold": 60
		}
	],
	"envParams": {},         
	"customLogs": "stdout",              
	"initialDelaySeconds": 2,                  
	"dataBaseName":"flask_demo",
	"executeSQLs":[
		"CREATE DATABASE IF NOT EXISTS flask_demo;",
		"USE flask_demo;",
		"CREATE TABLE IF NOT EXISTS `Counters` (`id` int(11) NOT NULL AUTO_INCREMENT, `count` int(11) NOT NULL DEFAULT 1, `createdAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, `updatedAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (`id`)) ENGINE = InnoDB DEFAULT CHARSET = utf8;",
		"CREATE TABLE IF NOT EXISTS `DownloadRecords` (`id` int(11) NOT NULL AUTO_INCREMENT, `openid` varchar(128) NOT NULL, `inputText` text, `extractUrl` text, `status` varchar(32) NOT NULL DEFAULT 'processing', `errorMsg` text, `videoId` varchar(128) DEFAULT NULL, `title` text, `thumbnail` text, `duration` int(11) DEFAULT NULL, `durationString` varchar(64) DEFAULT NULL, `resolution` varchar(64) DEFAULT NULL, `uploader` varchar(255) DEFAULT NULL, `webpageUrl` text, `originalUrl` text, `downloadUrl` text, `ext` varchar(32) DEFAULT NULL, `filename` varchar(255) DEFAULT NULL, `size` bigint DEFAULT 0, `fileUrl` text, `downloadPath` text, `downloadCount` int(11) NOT NULL DEFAULT 0, `extractedAt` datetime NOT NULL, `createdAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, `updatedAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP, PRIMARY KEY (`id`), KEY `idx_openid_extractedAt` (`openid`,`extractedAt`)) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4;"
	]    
}
